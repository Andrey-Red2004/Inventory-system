{
  "compilerOptions": {
    "target": "ES5",
    "lib": ["DOM", "ES6"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "main.ts"
  ],
  "exclude": [
    "main.js",
    "node_modules"
  ]
}
